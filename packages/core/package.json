{
  "name": "@react-code-finder/core",
  "version": "0.0.4",
  "description": "Inspect React components and copy source locations to clipboard",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "import": "./dist/transform.js",
      "require": "./dist/transform.cjs"
    },
    "./client-bundle": {
      "import": "./dist/client-bundle.global.js",
      "require": "./dist/client-bundle.global.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "keywords": [
    "react",
    "devtools",
    "inspector",
    "component",
    "source-location"
  ],
  "author": "Jonghakseo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonghakseo/react-code-finder",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Jonghakseo/react-code-finder#readme",
  "bugs": {
    "url": "https://github.com/Jonghakseo/react-code-finder/issues"
  }
}
