{
  "name": "@react-code-finder/nextjs",
  "version": "0.0.3",
  "description": "Next.js plugin for react-code-finder - Inspect React components and copy source locations",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loader": {
      "require": "./dist/loader.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "keywords": [
    "react",
    "nextjs",
    "next-plugin",
    "devtools",
    "inspector"
  ],
  "author": "Jonghakseo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonghakseo/react-code-finder",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/Jonghakseo/react-code-finder#readme",
  "bugs": {
    "url": "https://github.com/Jonghakseo/react-code-finder/issues"
  },
  "dependencies": {
    "@react-code-finder/core": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
