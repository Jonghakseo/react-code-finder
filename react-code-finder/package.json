{
  "name": "react-code-finder",
  "version": "0.0.1",
  "description": "Find React component source code locations in your browser",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    },
    "./next": {
      "types": "./dist/next-plugin.d.ts",
      "import": "./dist/next-plugin.js",
      "require": "./dist/next-plugin.cjs"
    },
    "./jsx-transform-loader": {
      "require": "./dist/jsx-transform-loader.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "react",
    "devtools",
    "code-finder",
    "vite",
    "nextjs"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "next": ">=12.0.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
